package main

import (
	"fmt"
	"github.com/seeadoog/expr"
)

func main() {

	env := expr.NewEnv()

	e, err := env.ParseFromJSONStr(`
[
	"[1,2].for(e => print(e))",
	"lib.add = {a,b} => return(a+b)",
	"print(lib.add(1,3))"
]

`)
	if err != nil {
		panic(err)
	}

	c := env.NewContext(nil)

	err = c.SafeExec(e)
	if err != nil {
		panic(err)
	}
	fmt.Println(c.GetReturn())
	fmt.Println(c.Env == env)

}
