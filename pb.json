{

  "svc": "ttsf",
  "pgn": [
    {
      "on_continue": [
        "ctx.data.write(ctx.call('tts','x598xsf'))",
        {
          "if": "ctx.data.len() > 0",
          "then": "call('its')"
        },
        {
          "define": {
            "rate_map":{
              "name": [0.1,0.4]
            }
          }
        },
        "set_rate(rate_map[req.name][0])"
      ]
    }
  ]
}